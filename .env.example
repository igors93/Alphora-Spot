# Copy to .env at the repository root and replace the placeholders.
# Spot / Intelligent Capital Rotation configuration:
ALPHORA_MARKET_TYPE=SPOT
BINANCE_SPOT_API_KEY=your_binance_spot_api_key
BINANCE_SPOT_API_SECRET=your_binance_spot_api_secret

# DRY_RUN | PAPER_LIVE | TESTNET_LIVE | REAL_LIVE
ALPHORA_EXECUTION_MODE=DRY_RUN

# TESTNET or REAL for DRY_RUN/PAPER_LIVE; TESTNET_LIVE and REAL_LIVE force their own.
ALPHORA_ENVIRONMENT=TESTNET

# Multi-symbol Capital Rotation across BTC, ETH, SOL, BNB, XRP:
ALPHORA_MULTI_SYMBOL_ENABLED=true
ALPHORA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
ALPHORA_MAX_ACTIVE_SYMBOLS=5
ALPHORA_LOOP_INTERVAL_SECONDS=1
ALPHORA_GOVERNOR_REQUEST_BUDGET_MAX_HEAVY_CHECKS_PER_CYCLE=5
ALPHORA_STRATEGY_MODULE=strategies.futures.fixed.spot_capital_rotation
ALPHORA_STRATEGY_CLASS=SpotCapitalRotationStrategy
