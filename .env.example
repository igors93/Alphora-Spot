# Copy to .env at the repository root and replace the placeholders.
# Every mode needs Binance USDT-M Futures credentials, including DRY_RUN:
# it never sends orders, but it reads the account through signed endpoints.
BINANCE_FUTURES_API_KEY=your_binance_futures_api_key
BINANCE_FUTURES_API_SECRET=your_binance_futures_api_secret

# DRY_RUN | PAPER_LIVE | TESTNET_LIVE | REAL_LIVE
ALPHORA_EXECUTION_MODE=DRY_RUN

# TESTNET or REAL for DRY_RUN/PAPER_LIVE; TESTNET_LIVE and REAL_LIVE force their own.
ALPHORA_ENVIRONMENT=TESTNET
